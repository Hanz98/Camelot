# Google C++ style with the project's few explicit choices spelled out so the
# result does not drift between clang-format releases. Run through pre-commit
# (clang-format hook) or `clang-format -i <file>`.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 80
IndentWidth: 2
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
# The groups follow cpplint's build/include_order: C headers (which for
# cpplint means every <x.h>, so Vulkan, GLFW, spdlog, gtest, VMA and
# vk-bootstrap land here), the C++ standard library, other third-party
# headers such as GLM's .hpp files, then project headers.
IncludeCategories:
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<[a-z_]+>$'
    Priority: 2
  - Regex: '^<.*'
    Priority: 3
  - Regex: '^"'
    Priority: 4
IncludeIsMainRegex: '$'
SortIncludes: CaseSensitive
...
