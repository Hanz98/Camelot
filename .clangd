CompileFlags:
  Add: [-std=c++20, -Wall, -Wextra, -Wpedantic]
  Remove: [-W*, -fcoroutines-ts]

Index:
  Background: Build

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes

Diagnostics:
  ClangTidy:
    Add: [cppcoreguidelines-*, modernize-*, readability-*, performance-*]
    Remove: [modernize-use-trailing-return-type]
  UnusedIncludes: Strict