# cppcheck suppressions, used by scripts/linux/runStaticAnalysis.sh.
# Format: <id>[:<file glob>[:<line>]]

# Third-party and dependency headers are not on the include path for cppcheck.
missingIncludeSystem

# Tests deliberately inspect objects after moving from them.
accessMoved:*Tests/Avalon/*

# Dependency headers pulled in through the compile database.
*:*/.conan2/*

# The vendored mock ICD is third-party code; cppcheck 2.13 (Ubuntu 24.04)
# does not honour -i for --project inputs, so suppress it here as well.
*:*/Tests/ext/*
