# clang-tidy configuration. Run through scripts/linux/runStaticAnalysis.sh or
# `clang-tidy -p build/Release <file>`; CI runs it on every PR.
#
# Disabled checks:
#   avoid-magic-numbers                 Vulkan code is full of literal counts,
#                                       sizes and version numbers.
#   pro-bounds-avoid-unchecked-container-access
#                                       operator[] on std::array/std::vector
#                                       is used deliberately in hot paths.
#   modernize-use-trailing-return-type  Not the style used here.
#   bugprone-invalid-enum-default-initialization
#                                       Vulkan structs are zero-initialised
#                                       with `= {}`; their enum members have
#                                       no zero enumerator by design.
#   bugprone-easily-swappable-parameters
#                                       Vulkan APIs take many adjacent
#                                       uint32_t/VkFormat parameters by design.
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  cppcoreguidelines-*,
  modernize-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -modernize-use-trailing-return-type,
  -bugprone-easily-swappable-parameters,
  -bugprone-invalid-enum-default-initialization
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(Avalon|Camelot|Excalibur|Pendragon|Tests)/.*'
ExcludeHeaderFilterRegex: '.*/(build|Tests/ext)/.*'
FormatStyle: file
CheckOptions:
  cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors: 'true'
  cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: 'true'
  modernize-loop-convert.MaxCopySize: '16'
  modernize-loop-convert.MinConfidence: reasonable
  modernize-loop-convert.NamingStyle: CamelCase
  modernize-use-nullptr.NullMacros: 'NULL'
