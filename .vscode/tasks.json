        "type": "shell",
        "command": "conan",
        "args": ["install", ".",  "--build=missing", "-s", "build_type=Debug"],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "detail": "Install dependencies using Conan."
      },
      {
        "label": "Conan Install Release",
        "type": "shell",
        "command": "conan",
        "args": ["install", ".", "--build=missing", "-s", "build_type=Release"],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "detail": "Install dependencies using Conan."
      },
      {
        "label": "Configure Debug",
        "type": "shell",
        "command": "cmake",
        "args": ["--preset", "debug"],
