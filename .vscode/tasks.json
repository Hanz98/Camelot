{
    "version": "2.0.0",
    "tasks": [
        {
          "label": "Conan Install Release",
          "type": "shell",
          "command": "conan",
          "args": ["install", ".", "-s", "build_type=Release",  "--build=missing", "--output-folder=build\\conan", "--profile=profiles/Camelot"],
          "group": {
            "kind": "build",
            "isDefault": false
          },
          "detail": "Install dependencies using Conan for release."
        },
        {
          "label": "Conan Install Debug",
          "type": "shell",
          "command": "conan",
          "args": ["install", ".", "-s", "build_type=Debug",  "--build=missing", "--output-folder=build\\conan", "--profile=profiles/Camelot"],
          "group": {
            "kind": "build",
            "isDefault": false
          },
          "detail": "Install dependencies using Conan for debug."
        }
    ]
}

